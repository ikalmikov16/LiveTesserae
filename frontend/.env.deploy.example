# Frontend deployment config
# Copy this file to .env.deploy and fill in your values
# DO NOT commit .env.deploy

# Baked into the bundle at build time by Vite — deploy.sh exports these before
# calling `bun run build`, and refuses to build if VITE_API_BASE_URL is missing
# or points at localhost. Without it the built site talks to http://localhost:8000
# and only a console.warn hints at why nothing works.
#
# Must be https: the site is served over HTTPS, and a browser blocks an http://
# API (and the ws:// derived from it) as mixed content. Set
# ALLOW_INSECURE_API_URL=1 to override for a non-HTTPS test deploy.
#
# The API is same-origin with the site (Caddy proxies /api/* and /ws to the app
# container), so this is normally just the site's own URL.
VITE_API_BASE_URL=https://your-domain.example

# rsync target. DEPLOY_PATH must be the directory Caddy serves as /srv/www —
# deploy.sh runs rsync with --delete, so anything else living there is removed.
DEPLOY_HOST=admin@your.static.ip
DEPLOY_PATH=/opt/tesserae/www

# Optional: identity file for the rsync ssh connection. Omit to use your
# default ssh config/agent.
SSH_KEY=

# CDN URL for chunk images - optional, and unset in the current deployment.
# Chunk images are served by the app at /api/chunks/... with a no-cache +
# ETag validator; pointing this at a separate origin reintroduces the cache
# policy trap (any CDN in front must include the `v` query string, which the
# commonly documented CachingOptimized policy excludes).
# VITE_CDN_BASE_URL=
