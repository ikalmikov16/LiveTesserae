# Frontend deployment config
# Copy this file to .env.deploy and fill in your values
# DO NOT commit .env.deploy

S3_BUCKET=your-frontend-s3-bucket-name
CLOUDFRONT_DIST_ID=your-cloudfront-distribution-id

# Baked into the bundle at build time by Vite — deploy.sh exports these before
# calling `bun run build`, and refuses to build if VITE_API_BASE_URL is missing
# or points at localhost. Without it the built site talks to http://localhost:8000
# and only a console.warn hints at why nothing works.
#
# Must be https: the site is served over HTTPS, and a browser blocks an http://
# API (and the ws:// derived from it) as mixed content. Set
# ALLOW_INSECURE_API_URL=1 to override for a non-HTTPS test deploy.
VITE_API_BASE_URL=https://api.your-domain.example

# CDN URL for chunk images (CloudFront) - optional.
# If set, chunk and overview images load from the CDN instead of the API.
VITE_CDN_BASE_URL=https://d1234abcd.cloudfront.net
