# Live Tesserae Backend Configuration
# Copy this file to .env and adjust values as needed

# Database connection
DATABASE_URL=postgresql://tesserae:tesserae_local@localhost:5433/tesserae

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated)
# Add your frontend CloudFront URL for production
CORS_ORIGINS=http://localhost:5173

# Mosaic configuration
GRID_WIDTH=1000
GRID_HEIGHT=1000
TILE_SIZE=32
CHUNK_SIZE=100

# =============================================================================
# Storage Configuration
# =============================================================================

# Storage mode: "local" or "s3"
STORAGE_MODE=local

# Local storage paths (used when STORAGE_MODE=local)
STORAGE_PATH=storage
TILES_PATH=storage/tiles
CHUNKS_PATH=storage/chunks

# S3 configuration (used when STORAGE_MODE=s3)
AWS_S3_BUCKET=live-tesserae-chunks-YOUR_USERNAME
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=       # Optional if using IAM roles or ~/.aws/credentials
AWS_SECRET_ACCESS_KEY=   # Optional if using IAM roles or ~/.aws/credentials
