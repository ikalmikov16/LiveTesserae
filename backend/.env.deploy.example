# Backend deployment config
# Copy this file to .env.deploy and fill in your values
# DO NOT commit .env.deploy

AWS_ACCOUNT_ID=your-aws-account-id
AWS_REGION=us-east-2
ECR_REPO=live-tesserae-backend
ECS_CLUSTER=live-tesserae-cluster
ECS_SERVICE=live-tesserae-backend-service
RDS_INSTANCE_ID=live-tesserae-db

# ---------------------------------------------------------------------------
# Used by ./register-task-def.sh to render task-def.json (which is a template).
# ---------------------------------------------------------------------------

AWS_S3_BUCKET=live-tesserae-chunks-YOUR_USERNAME
CORS_ORIGINS=https://tesserae.live,https://www.tesserae.live

# Number of reverse proxies YOU control in front of the app: 1 = ALB only,
# 2 = CloudFront -> ALB. register-task-def.sh refuses to register with 0.
#
# At 0 behind a load balancer the X-Forwarded-For header is ignored and every
# request carries the balancer's IP, so ws_max_connections_per_ip (10) becomes a
# cap of ten concurrent visitors for the entire site, and the tile rate limit
# becomes site-wide too. Use 2 only if the ALB cannot be reached directly —
# otherwise a client bypassing CloudFront controls the entry we read.
TRUSTED_PROXY_HOPS=1

# Secrets Manager ARN holding the full DATABASE_URL connection string. The
# password must never be committed — the old task-def.json leaked one into this
# public repo's git history. Create it with:
#   aws secretsmanager create-secret --name live-tesserae/database-url \
#     --secret-string 'postgresql://USER:PASSWORD@HOST:5432/tesserae'
# The task EXECUTION role needs secretsmanager:GetSecretValue on this ARN.
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-2:123456789012:secret:live-tesserae/database-url-AbCdEf

# How long the Level-0 overview rebuild waits to collect dirty chunks.
# Higher = less render load, staler overview at zoom level 0. Optional.
OVERVIEW_COALESCE_SECONDS=5
