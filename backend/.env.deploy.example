# Backend deployment config
# Copy this file to .env.deploy and fill in your values
# DO NOT commit .env.deploy

# The Lightsail box. deploy.sh ssh's here, pulls origin/main, rebuilds the
# image and restarts the app container.
DEPLOY_HOST=admin@your.static.ip

# Where docker-compose.yml, Caddyfile and .env live on the box. The git
# checkout is expected at $REMOTE_DIR/src.
REMOTE_DIR=/opt/tesserae

# Optional: identity file for the ssh connection. Omit to use your default
# ssh config/agent.
SSH_KEY=

# Optional: overridden only if the site is not at tesserae.live.
HEALTH_URL=https://tesserae.live/health

# ---------------------------------------------------------------------------
# Runtime settings live in /opt/tesserae/.env ON THE BOX, not here -- that file
# holds DATABASE_URL and POSTGRES_PASSWORD and is chmod 600, never committed,
# never copied off the host. Generate the password on the box itself:
#
#   openssl rand -hex 32
#
# Hex specifically: the password is embedded in a URL, and @ / : ? # in it
# break DATABASE_URL parsing in ways that present as a connection error
# pointing at the wrong host.
#
# TRUSTED_PROXY_HOPS must be 1 there (Caddy is the only proxy). At 0 the app
# ignores X-Forwarded-For, every request carries Caddy's IP, and
# ws_max_connections_per_ip=10 becomes a cap of ten concurrent visitors for the
# whole site.
# ---------------------------------------------------------------------------
